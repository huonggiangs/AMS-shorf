{
  "name": "@ams/ops-tools",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Sao luu/khoi phuc/dien tap (Postgres, D1), chuyen D1 -> Postgres (p3-ops)",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "backup": "tsx src/backup.ts",
    "restore": "tsx src/restore.ts",
    "drill": "tsx src/drill.ts",
    "d1-to-pg": "tsx src/d1-to-pg.ts"
