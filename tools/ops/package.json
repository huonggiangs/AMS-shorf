  "devDependencies": {
    "embedded-postgres": "16.15.0-beta.19",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "3.2.6",
    "@types/node": "22.18.0",
    "@types/pg": "8.15.5"
  }
