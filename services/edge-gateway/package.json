{
  "name": "@ams/edge-gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Gateway thiet bi: register/pair/heartbeat/manifest/events",
  "main": "./src/gateway.ts",
  "types": "./src/gateway.ts",
  "exports": {
    ".": "./src/gateway.ts",
    "./protocol": "./src/protocol.ts",
    "./node": "./src/node.ts",
    "./worker": "./src/worker.ts",
    "./testing": "./src/testing.ts",
    "./pairing": "./src/pairing.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.workers.json",
    "test": "vitest run --passWithNoTests",
    "build": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx watch src/index.ts"
  },
  "dependencies": {
    "@ams/shared": "workspace:*",
    "@ams/config": "workspace:*",
    "@ams/db": "workspace:*",
    "@ams/runtime": "workspace:*",
    "hono": "4.9.9",
    "@hono/node-server": "1.19.5",
    "zod": "3.25.76",
    "@ams/ingest-consumer": "workspace:*",
    "@ams/payments": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20260101.0"
  }
}
