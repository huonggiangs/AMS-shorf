{
  "name": "ams",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "build": "pnpm -r build",
    "dev": "pnpm -r --parallel dev",
    "e2e:smoke": "pnpm --filter @ams/e2e smoke",
    "e2e:ui": "pnpm --filter @ams/e2e-ui ui",
    "test:contract": "pnpm --filter @ams/contract-tests test",
    "test:chaos": "pnpm --filter @ams/chaos-tests test"
  },
  "devDependencies": {
    "@types/node": "22.18.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
