# =============================================================================
# AMS - mẫu cấu hình môi trường (.env.example)
# -----------------------------------------------------------------------------
# * Chạy `make setup` (hoặc `scripts/ams.ps1 setup` trên Windows): lệnh này COPY tệp này thành `.env`
#   và tự sinh các khóa ngẫu nhiên ở chỗ ghi "CHANGE_ME_AUTO".
# * KHÔNG commit tệp `.env`. KHÔNG dán khóa thật vào `.env.example`.
# * Dòng bắt đầu bằng # là chú thích. Để trống = không dùng / dùng mặc định.
# =============================================================================

# ----------------------------------------------------------------------------
# 1. Môi trường chạy
# ----------------------------------------------------------------------------
# docker     : chạy local bằng Docker Compose (Postgres, Redis, Mailpit; kho tệp = volume, không cần S3/MinIO)
# cloudflare : chạy trên Cloudflare Workers (cấu hình thật nằm ở wrangler.toml + secrets, KHÔNG đọc tệp này)
# k8s        : giai đoạn 2, Kubernetes (chưa triển khai)
RUNTIME=docker
# Môi trường ứng dụng (quyết định seed/guard, docs/SEED-AND-BOOTSTRAP.md): local | test | staging | production
# Không đặt = local (trừ RUNTIME=cloudflare|k8s thì coi là production). Ngoài `local`: seed mặc định là bootstrap,
# GATEWAY_DEV_ENDPOINTS bị từ chối, SEPAY_MODE=mock bị từ chối ở production.
AMS_ENV=local
NODE_ENV=production
# debug | info | warn | error
LOG_LEVEL=info

# ----------------------------------------------------------------------------
# 2. Tên miền công khai (Caddy cấp HTTPS tự ký cho *.ams.localhost)
# ----------------------------------------------------------------------------
APP_PUBLIC_URL=https://admin.ams.localhost
PORTAL_PUBLIC_URL=https://portal.ams.localhost
API_PUBLIC_URL=https://api.ams.localhost
GATEWAY_PUBLIC_URL=https://gw.ams.localhost
# Tên chuẩn dùng chung mọi môi trường (Docker local giữ *.ams.localhost; Cloudflare đặt trong wrangler.toml [vars]):
#   production: PUBLIC_ADMIN_URL=https://ams.anio.vn  PUBLIC_API_URL=https://ams.anio.vn/api  PUBLIC_GATEWAY_URL=https://gw-ams.anio.vn
#   staging   : https://ams-stg.anio.vn , https://ams-stg.anio.vn/api , https://gw-ams-stg.anio.vn
PUBLIC_ADMIN_URL=https://admin.ams.localhost
PUBLIC_API_URL=https://api.ams.localhost
PUBLIC_GATEWAY_URL=https://gw.ams.localhost
# URL dán vào my.sepay.vn > Webhooks. Local: dùng URL tunnel (make tunnel in ra).
# Production Cloudflare: https://ams.anio.vn/api/webhooks/payments/sepay   (staging: https://ams-stg.anio.vn/api/webhooks/payments/sepay)
SEPAY_WEBHOOK_URL=https://api.ams.localhost/webhooks/payments/sepay
# Nếu đang dùng tunnel (make tunnel), URL công khai của API hiện ở log; dán vào SePay.

# Cổng trên máy bạn (chỉ mở ở 127.0.0.1). Đổi nếu bị trùng cổng.
PROXY_HTTP_PORT=80
PROXY_HTTPS_PORT=443
WEB_ADMIN_PORT=8080
API_PORT=8787
GATEWAY_PORT=8788
POSTGRES_PORT=55432
REDIS_PORT=6379
# Cổng HTTP thuần của Caddy phát media công khai cho TV (renditions/*). MEDIA_BIND=0.0.0.0 để TV thật trong LAN truy cập được
MEDIA_PUBLIC_PORT=9000
MEDIA_BIND=127.0.0.1
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025

# ----------------------------------------------------------------------------
# 2b. Proxy / thiết bị giả lập
# ----------------------------------------------------------------------------
# 1 (mặc định): API/gateway tin X-Forwarded-For/X-Real-IP do Caddy ghi đè. Đặt 0 nếu mở thẳng cổng 8787/8788 ra mạng không tin cậy.
TRUST_PROXY=1
# MẶC ĐỊNH 0 (an toàn, R1-13). /v1/dev/pair-confirm KHÔNG xác thực: ai chạm tới gateway đều ghép được thiết bị giả.
# Chỉ đặt 1 khi AMS_ENV=local và cần tools/sim (make loadtest); env-guard từ chối 1 nếu AMS_ENV khác local.
GATEWAY_DEV_ENDPOINTS=0

# ----------------------------------------------------------------------------
# 3. Bí mật ứng dụng (make setup tự sinh; muốn tự sinh lại: xóa dòng giá trị rồi chạy lại `make setup`)
# ----------------------------------------------------------------------------
# Ký phiên đăng nhập (chuỗi ngẫu nhiên >= 32 ký tự)
SESSION_SECRET=CHANGE_ME_AUTO
# Khóa AES-256-GCM mã hóa theo trường (MST, số tài khoản ngân hàng): ĐÚNG 32 byte, mã hóa base64.
# MẤT KHÓA NÀY = MẤT DỮ LIỆU ĐÃ MÃ HÓA. Sao lưu ở nơi an toàn trước khi dùng dữ liệu thật.
FIELD_ENC_KEY=CHANGE_ME_AUTO

# ----------------------------------------------------------------------------
# 4. Tài khoản Super admin mẫu (seed tạo khi chạy `make seed`)
# ----------------------------------------------------------------------------
SEED=1
# SEED_MODE: trống = tự chọn theo AMS_ENV (local -> demo, còn lại -> bootstrap). `make seed` gọi `setup.mjs seed-mode`;
#            `make bootstrap` ép bootstrap (chỉ Super admin + cấu hình tối thiểu, KHÔNG dữ liệu demo).
SEED_MODE=
# 1 = cho phép seed demo ở staging/production (chỉ dùng cho CSDL thử, không bao giờ CSDL thật)
AMS_ALLOW_DEMO_SEED=0
# Bootstrap (staging/production): email Super admin đầu tiên (không được là email mẫu .local/.example).
# KHÔNG đặt mật khẩu bootstrap trong .env production: dùng BOOTSTRAP_ADMIN_PASSWORD_FILE (docker secret) hoặc nhập ẩn khi được hỏi.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD_FILE=
# BOOTSTRAP_ADMIN_PASSWORD=      # chỉ cho thử nghiệm cục bộ; >= 12 ký tự, có hoa/thường/số
# BOOTSTRAP_TENANT_NAME=
# BOOTSTRAP_TENANT_TAX_CODE=
SEED_ADMIN_EMAIL=admin@ams.localhost
SEED_ADMIN_PASSWORD=CHANGE_ME_AUTO
# Mã bí mật TOTP (base32) của Super admin mẫu, để đăng nhập khi chưa có app xác thực:
# chạy `node scripts/setup.mjs totp` để xem mã 6 số hiện tại, hoặc quét QR/URI mà lệnh này in ra.
SEED_ADMIN_TOTP_SECRET=CHANGE_ME_AUTO

# ----------------------------------------------------------------------------
# 5. PostgreSQL 16 (RUNTIME=docker)
# ----------------------------------------------------------------------------
POSTGRES_USER=ams
POSTGRES_PASSWORD=CHANGE_ME_AUTO
POSTGRES_DB=ams
# Chuỗi kết nối khi chạy NGOÀI container (pnpm dev trên máy bạn). Trong Docker, compose tự ghép.
DATABASE_URL=postgres://ams:CHANGE_ME_AUTO@localhost:5432/ams

# ----------------------------------------------------------------------------
# 6. Redis 7 (KV, rate limit, hàng đợi nhẹ)
# ----------------------------------------------------------------------------
REDIS_PASSWORD=CHANGE_ME_AUTO
REDIS_URL=redis://:CHANGE_ME_AUTO@localhost:6379

# ----------------------------------------------------------------------------
# 7. Kho tệp media
#    Docker local: OBJECT_STORE=fs  -> tệp nằm trên volume `mediadata` dùng chung (api/gateway/media-worker/Caddy), KHÔNG cần S3/MinIO.
#    Production/Cloudflare: OBJECT_STORE=s3 + S3_* (R2 dùng binding trong wrangler.toml).
# ----------------------------------------------------------------------------
OBJECT_STORE=fs
# Đường dẫn trong container (đã gắn volume). Chạy API ngoài Docker: đặt thư mục bất kỳ, vd ./data/objects
OBJECT_STORE_DIR=/data/objects
# Tiền tố URL ký cho tải lên/xem bản gốc (API phục vụ; đi qua nginx của web-admin). Mặc định /api/storage
OBJECT_STORE_SIGNED_BASE_URL=/api/storage
# Trần dung lượng 1 lần tải lên (MB); mỗi URL ký còn bị giới hạn theo size_bytes đã khai báo + quota khách hàng
OBJECT_STORE_MAX_UPLOAD_MB=600
# Địa chỉ TV tải media CÔNG KHAI (manifest dùng): Caddy phục vụ chỉ-đọc <PUBLIC_MEDIA_BASE_URL>/renditions/... từ volume.
# Trên TV thật phải là IP LAN của PC (và MEDIA_BIND=0.0.0.0), vd http://192.168.1.10:9000/media-public
PUBLIC_MEDIA_BASE_URL=http://localhost:9000/media-public
# R1-03: chỉ các tiền tố này được đọc công khai (bản đã quét + chuyển mã của media-worker). Bản gốc `media/...` KHÔNG BAO GIỜ
# được phát (Caddy từ chối tiền tố `media`). Nhiều tiền tố: cách nhau bằng dấu cách hoặc dấu phẩy.
MEDIA_PUBLIC_PREFIXES=renditions
# --- chỉ khi OBJECT_STORE=s3 (S3/R2 thật; MinIO đã bỏ):
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# S3_PUBLIC_ENDPOINT=
# S3_BUCKET=ams-media
# S3_REGION=auto
# S3_ACCESS_KEY=
# S3_SECRET_KEY=

# ----------------------------------------------------------------------------
# 8. Email thử: Mailpit (bắt thư, không gửi ra ngoài). Xem thư tại http://localhost:8025
# ----------------------------------------------------------------------------
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM=AMS <no-reply@ams.localhost>
# Mailpit không cần tài khoản. Khi dùng SMTP thật, điền thêm:
SMTP_USER=
SMTP_PASSWORD=

# ----------------------------------------------------------------------------
# 9. SePay (nhận tiền tự động)
# ----------------------------------------------------------------------------
# mock       : dùng nút "Mô phỏng giao dịch" (/dev/sepay/simulate), không gọi SePay
# sandbox    : SePay thử nghiệm; cần URL công khai (make tunnel)
# production : tiền thật. Endpoint /dev/sepay/simulate TỰ ĐỘNG TẮT.
SEPAY_MODE=mock
# Khóa HMAC-SHA256 ký webhook (dán cùng giá trị vào my.sepay.vn > Webhooks > Bảo mật)
SEPAY_WEBHOOK_SECRET=CHANGE_ME_AUTO
# Tùy chọn: chế độ Authorization: Apikey (nếu dùng thay HMAC)
SEPAY_API_KEY=
# Token gọi API giao dịch SePay để đối soát bù (tùy chọn)
SEPAY_API_TOKEN=
# Số tài khoản 0123456789 chỉ là SỐ MẪU. Số thật nhập trong trang Cài đặt > SePay của web admin.

# ----------------------------------------------------------------------------
# 9b. media-worker + ClamAV (quét mã độc, chuyển mã ffmpeg; profile core)
# ----------------------------------------------------------------------------
# 0 (local): thiếu clamd vẫn chạy, creative thành `unscanned`. PRODUCTION PHẢI = 1 (không quét được thì không duyệt/phát).
CLAMAV_REQUIRED=0
# 0 = bỏ chuyển mã (máy yếu); 1 = chuyển mã ffmpeg
MEDIA_TRANSCODE=1
MEDIA_FFMPEG_THREADS=2
# Giới hạn tệp (byte). Worker đọc cả tệp vào RAM: giới hạn memory của container media-worker (compose: 1280M) >= 2x giá trị này.
MEDIA_MAX_BYTES=536870912
MEDIA_SWEEP_S=60
# clamd StreamMaxLength/MaxFileSize (quá giới hạn => `unscanned`, không bao giờ `clean`)
CLAMAV_STREAM_MAX=512M
# CLAMAV_IMAGE=clamav/clamav:1.4

# ----------------------------------------------------------------------------
# 10. Sự kiện / hàng đợi (chỉ cần khi `make up-events`)
# ----------------------------------------------------------------------------
# Hàng đợi luôn là Redis (code không dùng Redpanda/Kafka); ingest-consumer chạy trong profile core.
# ClickHouse TÙY CHỌN: để trống = ghi sự kiện vào bảng Postgres ev_*.
# Khi bật: http://clickhouse:8123 (trong Docker) hoặc http://localhost:8123 (ngoài Docker)
CLICKHOUSE_URL=
CLICKHOUSE_DB=ams
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=

# ----------------------------------------------------------------------------
# 11. Quan sát (profile obs): Grafana + OpenTelemetry Collector
# ----------------------------------------------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_AUTO
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
SENTRY_DSN=

# ----------------------------------------------------------------------------
# 12. Cloudflare (RUNTIME=cloudflare). CHỈ dùng cho scripts/deploy-cloudflare.mjs và Terraform.
#     Bí mật của Worker KHÔNG để ở đây. Chúng đi qua biến môi trường/GitHub Secret tên AMS_SECRET_<TÊN>
#     (AMS_SECRET_SESSION_SECRET, AMS_SECRET_FIELD_ENC_KEY, AMS_SECRET_SEPAY_WEBHOOK_SECRET, AMS_SECRET_R2_*, AMS_SECRET_MAIL_*),
#     để scripts/deploy-cloudflare.mjs đặt bằng `wrangler secret bulk` (xem docs/DEPLOY-CLOUDFLARE.md mục 5). Đặt ở shell/CI, KHÔNG ghi vào tệp này.
# ----------------------------------------------------------------------------
# Token tạo ở dash.cloudflare.com > My Profile > API Tokens (quyền tối thiểu: xem docs/DEPLOY-CLOUDFLARE.md)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
# Zone Cloudflare: anio.vn PHẢI nằm trong tài khoản Cloudflare của bạn (nameserver trỏ về Cloudflare).
# Tên máy chủ cố định (khai báo trong infra/cloudflare/*/wrangler.toml):
#   production: ams.anio.vn (web admin + cổng khách + /api/*) và gw-ams.anio.vn (thiết bị)
#   staging   : ams-stg.anio.vn và gw-ams-stg.anio.vn
CLOUDFLARE_ZONE_NAME=anio.vn
CLOUDFLARE_ZONE_ID=
# Token của tunnel có tên (tùy chọn; `make tunnel` mặc định dùng quick tunnel, không cần token)
CLOUDFLARED_TUNNEL_TOKEN=

# ----------------------------------------------------------------------------
# 13. Kubernetes (RUNTIME=k8s) - GIAI ĐOẠN 2, chưa dùng
# ----------------------------------------------------------------------------
KUBE_NAMESPACE=ams

# ----------------------------------------------------------------------------
# 14. Nâng cao (tùy chọn): ghim phiên bản image / đổi cổng phụ. Bỏ dấu # để dùng.
#     Các tag mặc định nằm trong infra/docker/docker-compose.yml. Nếu Docker Hub bị chặn,
#     trỏ sang kho nội bộ (mirror) bằng các biến này.
# ----------------------------------------------------------------------------
# POSTGRES_IMAGE=postgres:16-alpine
# REDIS_IMAGE=redis:7-alpine
# MAILPIT_IMAGE=axllent/mailpit:v1.21
# CADDY_IMAGE=caddy:2-alpine
# MEDIA_PUBLIC_PREFIXES, CLAMAV_IMAGE: xem mục 7 và 9b
# REDPANDA_IMAGE=redpandadata/redpanda:v24.3.18
# CLICKHOUSE_IMAGE=clickhouse/clickhouse-server:24.8
# OTEL_IMAGE=otel/opentelemetry-collector-contrib:0.111.0
# GRAFANA_IMAGE=grafana/grafana:11.3.0
# CLOUDFLARED_IMAGE=cloudflare/cloudflared:2024.12.2
# REDPANDA_EXTERNAL_PORT=19092
# CLICKHOUSE_HTTP_PORT=8123
# CLICKHOUSE_NATIVE_PORT=9440
# GRAFANA_PORT=3000
# OTEL_GRPC_PORT=4317
# OTEL_HTTP_PORT=4318
