# =============================================================================
# AMS - mẫu cấu hình môi trường (.env.example)
# -----------------------------------------------------------------------------
# * Chạy `make setup` (hoặc `scripts/ams.ps1 setup` trên Windows): lệnh này COPY tệp này thành `.env`
#   và tự sinh các khóa ngẫu nhiên ở chỗ ghi "CHANGE_ME_AUTO".
# * KHÔNG commit tệp `.env`. KHÔNG dán khóa thật vào `.env.example`.
# * Dòng bắt đầu bằng # là chú thích. Để trống = không dùng / dùng mặc định.
# =============================================================================

# ----------------------------------------------------------------------------
# 1. Môi trường chạy
# ----------------------------------------------------------------------------
# docker     : chạy local bằng Docker Compose (Postgres, Redis, MinIO, Mailpit)
# cloudflare : chạy trên Cloudflare Workers (cấu hình thật nằm ở wrangler.toml + secrets, KHÔNG đọc tệp này)
# k8s        : giai đoạn 2, Kubernetes (chưa triển khai)
RUNTIME=docker
NODE_ENV=production
# debug | info | warn | error
LOG_LEVEL=info

# ----------------------------------------------------------------------------
# 2. Tên miền công khai (Caddy cấp HTTPS tự ký cho *.ams.localhost)
# ----------------------------------------------------------------------------
APP_PUBLIC_URL=https://admin.ams.localhost
PORTAL_PUBLIC_URL=https://portal.ams.localhost
API_PUBLIC_URL=https://api.ams.localhost
GATEWAY_PUBLIC_URL=https://gw.ams.localhost
# Tên chuẩn dùng chung mọi môi trường (Docker local giữ *.ams.localhost; Cloudflare đặt trong wrangler.toml [vars]):
#   production: PUBLIC_ADMIN_URL=https://ams.anio.vn  PUBLIC_API_URL=https://ams.anio.vn/api  PUBLIC_GATEWAY_URL=https://gw-ams.anio.vn
#   staging   : https://ams-stg.anio.vn , https://ams-stg.anio.vn/api , https://gw-ams-stg.anio.vn
PUBLIC_ADMIN_URL=https://admin.ams.localhost
PUBLIC_API_URL=https://api.ams.localhost
PUBLIC_GATEWAY_URL=https://gw.ams.localhost
# URL dán vào my.sepay.vn > Webhooks. Local: dùng URL tunnel (make tunnel in ra).
# Production Cloudflare: https://ams.anio.vn/api/webhooks/payments/sepay   (staging: https://ams-stg.anio.vn/api/webhooks/payments/sepay)
SEPAY_WEBHOOK_URL=https://api.ams.localhost/webhooks/payments/sepay
# Nếu đang dùng tunnel (make tunnel), URL công khai của API hiện ở log; dán vào SePay.

# Cổng trên máy bạn (chỉ mở ở 127.0.0.1). Đổi nếu bị trùng cổng.
PROXY_HTTP_PORT=80
PROXY_HTTPS_PORT=443
WEB_ADMIN_PORT=8080
API_PORT=8787
GATEWAY_PORT=8788
POSTGRES_PORT=5432
REDIS_PORT=6379
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025

# ----------------------------------------------------------------------------
# 3. Bí mật ứng dụng (make setup tự sinh; muốn tự sinh lại: xóa dòng giá trị rồi chạy lại `make setup`)
# ----------------------------------------------------------------------------
# Ký phiên đăng nhập (chuỗi ngẫu nhiên >= 32 ký tự)
SESSION_SECRET=CHANGE_ME_AUTO
# Khóa AES-256-GCM mã hóa theo trường (MST, số tài khoản ngân hàng): ĐÚNG 32 byte, mã hóa base64.
# MẤT KHÓA NÀY = MẤT DỮ LIỆU ĐÃ MÃ HÓA. Sao lưu ở nơi an toàn trước khi dùng dữ liệu thật.
FIELD_ENC_KEY=CHANGE_ME_AUTO

# ----------------------------------------------------------------------------
# 4. Tài khoản Super admin mẫu (seed tạo khi chạy `make seed`)
# ----------------------------------------------------------------------------
SEED=1
SEED_ADMIN_EMAIL=admin@ams.localhost
SEED_ADMIN_PASSWORD=CHANGE_ME_AUTO
# Mã bí mật TOTP (base32) của Super admin mẫu, để đăng nhập khi chưa có app xác thực:
# chạy `node scripts/setup.mjs totp` để xem mã 6 số hiện tại, hoặc quét QR/URI mà lệnh này in ra.
SEED_ADMIN_TOTP_SECRET=CHANGE_ME_AUTO

# ----------------------------------------------------------------------------
# 5. PostgreSQL 16 (RUNTIME=docker)
# ----------------------------------------------------------------------------
POSTGRES_USER=ams
POSTGRES_PASSWORD=CHANGE_ME_AUTO
POSTGRES_DB=ams
# Chuỗi kết nối khi chạy NGOÀI container (pnpm dev trên máy bạn). Trong Docker, compose tự ghép.
DATABASE_URL=postgres://ams:CHANGE_ME_AUTO@localhost:5432/ams

# ----------------------------------------------------------------------------
# 6. Redis 7 (KV, rate limit, hàng đợi nhẹ)
# ----------------------------------------------------------------------------
REDIS_PASSWORD=CHANGE_ME_AUTO
REDIS_URL=redis://:CHANGE_ME_AUTO@localhost:6379

# ----------------------------------------------------------------------------
# 7. MinIO (kho tệp tương thích S3; Cloudflare dùng R2)
# ----------------------------------------------------------------------------
MINIO_ROOT_USER=amsminio
MINIO_ROOT_PASSWORD=CHANGE_ME_AUTO
S3_BUCKET=ams-media
S3_REPORTS_BUCKET=ams-reports
S3_REGION=us-east-1
# Địa chỉ mà TRÌNH DUYỆT dùng để tải tệp lên bằng presigned URL (khác địa chỉ nội bộ minio:9000)
S3_PUBLIC_ENDPOINT=http://localhost:9000

# ----------------------------------------------------------------------------
# 8. Email thử: Mailpit (bắt thư, không gửi ra ngoài). Xem thư tại http://localhost:8025
# ----------------------------------------------------------------------------
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=AMS <no-reply@ams.localhost>
# Mailpit không cần tài khoản. Khi dùng SMTP thật, điền thêm:
SMTP_USER=
SMTP_PASSWORD=

# ----------------------------------------------------------------------------
# 9. SePay (nhận tiền tự động)
# ----------------------------------------------------------------------------
# mock       : dùng nút "Mô phỏng giao dịch" (/dev/sepay/simulate), không gọi SePay
# sandbox    : SePay thử nghiệm; cần URL công khai (make tunnel)
# production : tiền thật. Endpoint /dev/sepay/simulate TỰ ĐỘNG TẮT.
SEPAY_MODE=mock
# Khóa HMAC-SHA256 ký webhook (dán cùng giá trị vào my.sepay.vn > Webhooks > Bảo mật)
SEPAY_WEBHOOK_SECRET=CHANGE_ME_AUTO
# Tùy chọn: chế độ Authorization: Apikey (nếu dùng thay HMAC)
SEPAY_API_KEY=
# Token gọi API giao dịch SePay để đối soát bù (tùy chọn)
SEPAY_API_TOKEN=
# Số tài khoản 0123456789 chỉ là SỐ MẪU. Số thật nhập trong trang Cài đặt > SePay của web admin.

# ----------------------------------------------------------------------------
# 10. Sự kiện / hàng đợi (chỉ cần khi `make up-events`)
# ----------------------------------------------------------------------------
# redis | memory | redpanda. `make up-events` tự đặt redpanda + ClickHouse.
QUEUE_DRIVER=redis
KAFKA_BROKERS=redpanda:9092
# ClickHouse TÙY CHỌN: để trống = ghi sự kiện vào bảng Postgres ev_*.
# Khi bật: http://clickhouse:8123 (trong Docker) hoặc http://localhost:8123 (ngoài Docker)
CLICKHOUSE_URL=
CLICKHOUSE_DB=ams
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=

# ----------------------------------------------------------------------------
# 11. Quan sát (profile obs): Grafana + OpenTelemetry Collector
# ----------------------------------------------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_AUTO
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
SENTRY_DSN=

# ----------------------------------------------------------------------------
# 12. Cloudflare (RUNTIME=cloudflare). CHỈ dùng cho scripts/deploy-cloudflare.mjs và Terraform.
#     Bí mật của Worker KHÔNG để ở đây: dùng `wrangler secret put` (xem docs/DEPLOY-CLOUDFLARE.md).
# ----------------------------------------------------------------------------
# Token tạo ở dash.cloudflare.com > My Profile > API Tokens (quyền tối thiểu: xem docs/DEPLOY-CLOUDFLARE.md)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
# Zone Cloudflare: anio.vn PHẢI nằm trong tài khoản Cloudflare của bạn (nameserver trỏ về Cloudflare).
# Tên máy chủ cố định (khai báo trong infra/cloudflare/*/wrangler.toml):
#   production: ams.anio.vn (web admin + cổng khách + /api/*) và gw-ams.anio.vn (thiết bị)
#   staging   : ams-stg.anio.vn và gw-ams-stg.anio.vn
CLOUDFLARE_ZONE_NAME=anio.vn
CLOUDFLARE_ZONE_ID=
# Token của tunnel có tên (tùy chọn; `make tunnel` mặc định dùng quick tunnel, không cần token)
CLOUDFLARED_TUNNEL_TOKEN=

# ----------------------------------------------------------------------------
# 13. Kubernetes (RUNTIME=k8s) - GIAI ĐOẠN 2, chưa dùng
# ----------------------------------------------------------------------------
KUBE_NAMESPACE=ams

# ----------------------------------------------------------------------------
# 14. Nâng cao (tùy chọn): ghim phiên bản image / đổi cổng phụ. Bỏ dấu # để dùng.
#     Các tag mặc định nằm trong infra/docker/docker-compose.yml. Nếu Docker Hub bị chặn,
#     trỏ sang kho nội bộ (mirror) bằng các biến này.
# ----------------------------------------------------------------------------
# POSTGRES_IMAGE=postgres:16-alpine
# REDIS_IMAGE=redis:7-alpine
# MINIO_IMAGE=minio/minio:RELEASE.2025-04-22T22-12-26Z
# MINIO_MC_IMAGE=minio/mc:RELEASE.2025-04-16T18-13-26Z
# MAILPIT_IMAGE=axllent/mailpit:v1.21
# CADDY_IMAGE=caddy:2-alpine
# REDPANDA_IMAGE=redpandadata/redpanda:v24.3.18
# CLICKHOUSE_IMAGE=clickhouse/clickhouse-server:24.8
# OTEL_IMAGE=otel/opentelemetry-collector-contrib:0.111.0
# GRAFANA_IMAGE=grafana/grafana:11.3.0
# CLOUDFLARED_IMAGE=cloudflare/cloudflared:2024.12.2
# REDPANDA_EXTERNAL_PORT=19092
# CLICKHOUSE_HTTP_PORT=8123
# CLICKHOUSE_NATIVE_PORT=9440
# GRAFANA_PORT=3000
# OTEL_GRPC_PORT=4317
# OTEL_HTTP_PORT=4318
