# Sao chép thành terraform.tfvars (đã nằm trong .gitignore) rồi điền. Không có bí mật ở đây;
# token đặt bằng biến môi trường CLOUDFLARE_API_TOKEN.
account_id  = "ĐIỀN_ACCOUNT_ID"
zone_id     = "ĐIỀN_ZONE_ID"
zone_name   = "anio.vn"
environment = "staging" # hoặc production (dùng `terraform workspace new production`)

# Chỉ đặt true ở workspace production: ruleset rate limit là duy nhất theo zone và phủ cả ams-stg/gw-ams-stg.
manage_zone_rate_limit = false
