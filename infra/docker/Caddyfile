# Caddy: tên miền cục bộ *.ams.localhost, HTTPS tự ký (CA nội bộ của Caddy).
# Trình duyệt sẽ cảnh báo chứng chỉ lần đầu; chạy `make trust-ca` (hoặc `scripts/ams.ps1 trust-ca`)
# để xuất CA gốc và cài vào máy nếu muốn bỏ cảnh báo.
# *.localhost luôn trỏ về 127.0.0.1 trên Chrome/Edge/Firefox/Windows 11, không cần sửa hosts.
{
	# CA nội bộ, không gọi Let's Encrypt
	local_certs
	skip_install_trust
}

# GHI DE (khong noi them) header IP khach: API/gateway tin X-Forwarded-For / X-Real-IP (TRUST_PROXY=1) cho rate-limit
# va audit; neu de client tu gui thi co the gia IP. Cloudflare header cung bi go.
(client_ip) {
	header_up X-Forwarded-For {remote_host}
	header_up X-Real-IP {remote_host}
	header_up -CF-Connecting-IP
}

(security_headers) {
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}

# Web quản trị. nginx trong web-admin tự chuyển /api/* sang api (cùng origin => cookie phiên đơn giản).
admin.ams.localhost {
	tls internal
	import security_headers
	encode zstd gzip
	reverse_proxy web-admin:8080 {
		import client_ip
	}
}

# Cổng khách hàng/đối tác: cùng ứng dụng web, phân biệt theo tên miền.
portal.ams.localhost {
	tls internal
	import security_headers
	encode zstd gzip
	reverse_proxy web-admin:8080 {
		import client_ip
	}
}

# API trực tiếp (admin API, portal API, webhook SePay, /dev/sepay/simulate)
api.ams.localhost {
	tls internal
	import security_headers
	encode zstd gzip
	reverse_proxy api:8787 {
		import client_ip
		health_uri /health
		health_interval 15s
	}
}

# Edge gateway cho thiết bị/bộ giả lập (heartbeat, events, manifest)
gw.ams.localhost {
	tls internal
	import security_headers
	reverse_proxy edge-gateway:8788 {
		import client_ip
		health_uri /health
		health_interval 15s
	}
}

# ---- Media công khai cho TV (CHỈ ĐỌC): phát tĩnh từ volume dùng chung `mediadata` (mount ở /srv/objects, :ro).
# Chỉ các tiền tố trong MEDIA_PUBLIC_PREFIXES (mặc định `renditions`) => MEDIA_PUBLIC_PATHS="/media-public/renditions/*";
# mọi đường dẫn khác (bản gốc media/..., .meta/, .tmp/) trả 404. Không liệt kê thư mục. URL TV: PUBLIC_MEDIA_BASE_URL/<key>.
(media_public) {
	@mpub path {$MEDIA_PUBLIC_PATHS:/media-public/renditions/*}
	@mbad not method GET HEAD OPTIONS
	header {
		X-Content-Type-Options nosniff
		Access-Control-Allow-Origin *
		-Server
	}
	handle /media-public/healthz {
		respond "ok" 200
	}
	handle @mpub {
		respond @mbad 405
		header Cache-Control "public, max-age=300"
		uri strip_prefix /media-public
		root * /srv/objects
		file_server {
			hide .*
		}
	}
	handle {
		respond 404
	}
}

# HTTPS (tên miền cục bộ) và HTTP thuần :9000 (cho TV/thiết bị không tin CA nội bộ)
media.ams.localhost {
	tls internal
	import media_public
}
http://:9000 {
	import media_public
}
