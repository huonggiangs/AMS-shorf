# =============================================================================
# AMS VPS production: mau cau hinh (infra/vps/.env.example). KHONG chua bi mat that.
#   cp infra/vps/.env.example infra/vps/.env && chmod 600 infra/vps/.env     (.env bi .gitignore)
# Moi gia tri "CHANGE_ME_*" phai thay; env-guard tu choi khoi dong neu con sot.
# Sinh khoa:  openssl rand -base64 32   (FIELD_ENC_KEY: dung DUNG khoa dang chay tren Cloudflare, KHONG sinh moi khi chuyen du lieu)
# =============================================================================

# --- Ten mien (cung URL nhu Cloudflare) va chung chi
DOMAIN_APP=ams.anio.vn
DOMAIN_GW=gw-ams.anio.vn
# Email nhan thong bao het han chung chi Let's Encrypt
ACME_EMAIL=CHANGE_ME_admin@anio.vn

AMS_ENV=production
LOG_LEVEL=info
# Tag image (build tai cho tu ma nguon; neu dung registry rieng: AMS_REGISTRY=registry.example.com/ams)
AMS_TAG=prod
# AMS_REGISTRY=ams

# --- Bi mat ung dung
SESSION_SECRET=CHANGE_ME_SESSION_SECRET_32_CHARS_MIN
# DUNG khoa FIELD_ENC_KEY cua Cloudflare (base64 32 byte). Mat khoa = mat du lieu ma hoa theo truong.
FIELD_ENC_KEY=CHANGE_ME_FIELD_ENC_KEY_BASE64_32_BYTES
SEPAY_MODE=production
SEPAY_WEBHOOK_SECRET=CHANGE_ME_SEPAY_WEBHOOK_SECRET
SEPAY_API_KEY=
SEPAY_API_TOKEN=

# --- Postgres / Redis
POSTGRES_USER=ams
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
POSTGRES_DB=ams
# Cong chi mo tren 127.0.0.1 cua may chu (SSH tunnel de nhap du lieu / khoi phuc)
POSTGRES_HOST_PORT=5432
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
# Goi y cho VPS 4 GB RAM; VPS 8 GB: shared_buffers=1GB, effective_cache_size=4GB
PG_SHARED_BUFFERS=512MB
PG_EFFECTIVE_CACHE_SIZE=1536MB
PG_MAX_CONNECTIONS=150

# --- Migration / seed (chuyen tu Cloudflare: SEED=0; cai moi: SEED=1 + BOOTSTRAP_ADMIN_EMAIL)
SEED=0
SEED_MODE=bootstrap
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD_FILE=

# --- Thu giao dich (docs/ops/EMAIL-SETUP.md). Chon MOT: HTTP API hoac SMTP
MAIL_TRANSPORT=http
MAIL_HTTP_URL=https://api.resend.com/emails
MAIL_HTTP_KEY=CHANGE_ME_MAIL_API_KEY
MAIL_PROVIDER=resend
MAIL_FROM=AMS <no-reply@anio.vn>
MAIL_REPLY_TO=support@anio.vn
# SMTP (neu MAIL_TRANSPORT=smtp)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_REQUIRE_TLS=1

# --- Canh bao van hanh + trang trang thai (docs/ops/ONCALL.md)
OPS_ALERT_EMAILS=CHANGE_ME_truc1@anio.vn,CHANGE_ME_truc2@anio.vn
# Telegram: https://api.telegram.org/bot<TOKEN>/sendMessage  (kem OPS_ALERT_WEBHOOK_CHAT_ID). Slack/Discord: URL webhook den.
OPS_ALERT_WEBHOOK_URL=
OPS_ALERT_WEBHOOK_CHAT_ID=
# Ma dung chung giua sidecar sao luu va API (POST /ops/backup-report). Sinh: openssl rand -hex 24
OPS_REPORT_TOKEN=CHANGE_ME_OPS_REPORT_TOKEN

# --- Sao luu ma hoa (infra/vps/backup)
# Khoa ma hoa ban sao luu: LUU RIENG voi ban sao luu (it nhat 2 nguoi giu). Mat khoa = ban sao luu vo dung.
BACKUP_ENC_KEY=CHANGE_ME_BACKUP_ENC_KEY_MIN_16_CHARS
BACKUP_CRON=17 */6 * * *
BACKUP_KEEP=14
BACKUP_MEDIA=1
BACKUP_MEDIA_CRON=40 3 * * 0
# Sao chep ra NGOAI may chu (bat buoc cho production). Vi du Backblaze B2 / S3 / R2 qua rclone: remote ten OFFSITE dat bang RCLONE_CONFIG_OFFSITE_*
# BACKUP_RCLONE=OFFSITE:ten-bucket/ams
BACKUP_RCLONE=
RCLONE_CONFIG_OFFSITE_TYPE=s3
RCLONE_CONFIG_OFFSITE_PROVIDER=Other
RCLONE_CONFIG_OFFSITE_ACCESS_KEY_ID=
RCLONE_CONFIG_OFFSITE_SECRET_ACCESS_KEY=
RCLONE_CONFIG_OFFSITE_ENDPOINT=

# --- Media worker
MEDIA_FFMPEG_THREADS=2
MEDIA_MAX_BYTES=536870912
