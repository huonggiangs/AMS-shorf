+    /** AMS account link (6-digit code, 5 minutes). Visible only after a parent enabled ads from the phone and while the TV is not linked. */
+    private void updateAmsPairing() {
+        if (amsPairText == null) return;
+        android.content.SharedPreferences ams = getSharedPreferences("brainrot_ams", MODE_PRIVATE);
+        if (!ams.getBoolean("ads_enabled", false) || ams.getInt("trust_level", 0) >= 1) {
+            amsPairText.setVisibility(View.GONE);
+            return;
+        }
+        amsPairText.setVisibility(View.VISIBLE);
+        AmsCoordinator.PairSnapshot snap = AmsCoordinator.pairingSnapshot();
+        if (snap.code.isEmpty()) {
+            amsPairText.setText("Liên kết tài khoản AMS: đang lấy mã…");
+            return;
+        }
+        long left = Math.max(0L, (snap.expiresAtElapsedMs - android.os.SystemClock.elapsedRealtime()) / 1000L);
+        amsPairText.setText("Liên kết tài khoản AMS · mã " + snap.code + " · còn "
+            + (left / 60) + ":" + String.format(java.util.Locale.US, "%02d", left % 60));
+    }
