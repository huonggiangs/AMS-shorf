+    /** AMS: main thread. Puts the creative view into the lock's ad column; null clears it and returns the width to the lock panel. */
+    static boolean setLockAdView(View ad) {
+        if (Looper.myLooper() != Looper.getMainLooper()) return false;
+        FrameLayout slot = lockAdSlot;
+        if (slot == null || current == null || !current.isAttachedToWindow()) return false;
+        slot.removeAllViews();
+        if (ad == null) {
+            slot.setVisibility(View.GONE);
+            return true;
+        }
+        slot.addView(ad, new FrameLayout.LayoutParams(
+            WindowManager.LayoutParams.MATCH_PARENT, WindowManager.LayoutParams.MATCH_PARENT));
+        slot.setVisibility(View.VISIBLE);
